schema_version: 1
project:
  id: {{PROJECT_SLUG_JSON}}
  name: {{PROJECT_NAME_JSON}}
  kind: {{KIND}}
  purpose: {{PURPOSE_JSON}}
  generated_by:
    template: agent-builder
    version: "{{TEMPLATE_VERSION}}"
    generated_at: "{{GENERATED_AT}}"
  coding_agent_adapters:
{{ADAPTERS_YAML}}

phase:
  current: define
  status: awaiting_definition
  transition_requires: explicit_project_author_invocation_or_confirmation
  inferred_transitions_permitted: false
  history:
    - phase: define
      effective_date: {{GENERATED_DATE}}
      basis: Skill scaffold created; definition not yet approved.

distribution:
  plugin_manifest: .claude-plugin/plugin.json
  hosts_verified: []
  released: false

compatibility:
  skill_front_matter_versioned: true
  template_updates_automatic: false

security:
  secret_values_in_repository: forbidden
  secret_values_in_model_context: forbidden
  runtime_injection_required: true
